{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2016",
    "allowJs": true,
    "resolveJsonModule": true, 
    "moduleDetection": "force",
    "isolatedModules": true,
    "moduleResolution": "node", 

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true,

    "module": "CommonJS",
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "lib": ["ES2022"],

    "rootDir": "./src",
    "baseUrl": ".",

    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
