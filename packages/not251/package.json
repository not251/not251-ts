{
  "name": "@not251/not251",
  "version": "0.1.0",
  "description": "Libreria per calcoli e trasformazioni musicali tramite vettori.",
  "main": "./dist/index.js",
  "module": "./dist/esm_temp/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm_temp/index.js",
      "require": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build:esm": "tsc -p tsconfig.json --module esnext --outDir dist/esm_temp",
    "build:cjs": "tsc -p tsconfig.json --module commonjs --outDir dist",
    "build:types": "tsc -p tsconfig.json --declaration --emitDeclarationOnly --declarationMap --outDir dist/types",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:types",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "music",
    "theory",
    "typescript",
    "vector",
    "scale",
    "chord",
    "interval",
    "position",
    "not251",
    "alchemusa"
  ],
  "author": "Il Tuo Nome <tua.email@example.com>",
  "license": "MIT",
  "devDependencies": {
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
