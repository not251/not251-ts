{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "vai": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": false,
      "persistent": false
    },
    "maxmsp": {
      "cache": false,
      "persistent": false
    },
    "release": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": false
    },
    "docs": {
      "cache": false,
      "persistent": false
    }
  }
}
